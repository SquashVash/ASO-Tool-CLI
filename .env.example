# Copy to .env and edit. Every value here is optional; the defaults in
# aso/config.py are what actually run if you leave this file out entirely.

# --- storage -----------------------------------------------------------
ASO_DB_PATH=aso.db

# --- defaults ----------------------------------------------------------
# Two-letter storefront used when a command doesn't pass --country.
ASO_DEFAULT_COUNTRY=us

# --- rate limiting -----------------------------------------------------
# iTunes starts 403ing somewhere around 20 req/min per IP. 15 leaves headroom.
ASO_RATE_LIMIT_PER_MIN=15
ASO_MAX_CONCURRENCY=3
ASO_HTTP_TIMEOUT_SECONDS=20
ASO_RETRY_ATTEMPTS=4

# --- cache TTLs (days) -------------------------------------------------
ASO_SERP_TTL_DAYS=3
ASO_APP_TTL_DAYS=7
ASO_HINTS_TTL_DAYS=3

# --- Apple Search Ads --------------------------------------------------
# Needed only for `aso asa …` and `aso calibrate`. Everything else works
# without these. See the README's "Apple Search Ads setup" for how to get
# them; `aso asa whoami` verifies them and prints your org ID.
#
# clientId / teamId / keyId are shown ONCE when you create the API user in
# Search Ads → Account Settings → API. Copy them then.
ASO_ASA_CLIENT_ID=
ASO_ASA_TEAM_ID=
ASO_ASA_KEY_ID=
ASO_ASA_ORG_ID=

# Path to the P-256 private key YOU generated (not the public half you pasted
# into the Search Ads UI, and not a .p8 from Apple — since API v4 Apple does
# not issue the key, you do):
#
#   openssl ecparam -genkey -name prime256v1 -noout -out asa-private-key.pem
#   openssl ec -in asa-private-key.pem -pubout -out asa-public-key.pem
#
# *.pem and *.p8 are gitignored. Keep it that way.
ASO_ASA_PRIVATE_KEY_PATH=

# --- Apple keyword popularity (undocumented) ---------------------------
# Apple's own 5-100 demand index, from the GraphQL operation behind the
# keyword tool in the Apple Ads dashboard. Off by default: with it unset the
# demand score is the autocomplete + SERP proxy, exactly as before.
ASO_APPLE_POPULARITY_ENABLED=false

# Your app's numeric App Store id (the `adamId` the dashboard sends).
ASO_APPLE_ADAM_ID=

# This endpoint takes NO bearer token — it authenticates with the dashboard
# session cookie. Sign in at https://app-ads.apple.com, open DevTools ->
# Network, click any request to that host, and copy the entire `Cookie`
# request header here.
#
# Cookies expire on their own schedule, so expect to redo this periodically.
# `aso apple pull` reports a stale cookie as a stale cookie rather than as an
# endpoint failure.
ASO_APPLE_COOKIE=

# How long a popularity reading stays fresh. Apple's index lags impressions by
# about four days and moves slowly.
ASO_APPLE_POPULARITY_TTL_DAYS=14

# How the Apple Ads session is held:
#   browser  a real profile on disk, created by `aso apple login`. The only
#            option that survives a cookie expiring without you pasting a new
#            one. Needs the `browser` extra.
#   cookie   ASO_APPLE_COOKIE above. No extra dependency, expires on Apple's
#            schedule.
#   auto     use the browser profile if one exists, else the cookie.
ASO_APPLE_TRANSPORT=auto

# Where the saved session lives. Gitignored; treat it as a credential.
ASO_APPLE_PROFILE_DIR=./.apple-session

# --- HTTP API -------------------------------------------------------------
# The API has no authentication, by design. Loopback means only processes on
# this host can reach it. Change this only if you have put authentication in
# front of it.
ASO_API_HOST=127.0.0.1
ASO_API_PORT=8081
